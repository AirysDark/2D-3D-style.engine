<Window x:Class="GE2D3D.MapEditor.MapDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GE2D3D Map Diagnostics"
        Width="1200"
        Height="760"
        MinWidth="850"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh Analysis" Width="110" Margin="0,0,8,0" Click="OnRefreshClick" />
            <Button Content="Copy All" Width="90" Margin="0,0,8,0" Click="OnCopyAllClick" />
            <Button Content="Save Report" Width="100" Margin="0,0,8,0" Click="OnSaveReportClick" />
            <Button Content="Clear Trace" Width="100" Margin="0,0,8,0" Click="OnClearTraceClick" />
            <CheckBox x:Name="AutoRefreshCheckBox" Content="Live auto-refresh" IsChecked="True" VerticalAlignment="Center" />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" />
        </StatusBar>

        <TabControl x:Name="DiagnosticsTabs">
            <TabItem Header="Overview">
                <TextBox x:Name="OverviewTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" />
            </TabItem>
            <TabItem Header="Live Load Trace">
                <TextBox x:Name="TraceTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" />
            </TabItem>
            <TabItem Header="Raw Map">
                <TextBox x:Name="RawMapTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" />
            </TabItem>
            <TabItem Header="Parsed vs Raw">
                <TextBox x:Name="ComparisonTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" />
            </TabItem>
            <TabItem Header="Assets">
                <TextBox x:Name="AssetsTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" />
            </TabItem>
            <TabItem Header="Warnings &amp; Errors">
                <TextBox x:Name="WarningsTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
