<Window x:Class="GE2D3D.MapEditor.MapDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map Diagnostics"
        Width="850"
        Height="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Width="90" Margin="0,0,8,0" Click="OnRefreshClick" />
            <Button Content="Clear" Width="90" Click="OnClearClick" />
        </StackPanel>
        <TextBox x:Name="DiagnosticsTextBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13" />
    </DockPanel>
</Window>
