<Window x:Class="GE2D3D.EditorSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GE2D3D Editor Suite"
        Width="900"
        Height="560"
        MinWidth="700"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="GE2D3D"
                       FontSize="36"
                       FontWeight="Bold" />
            <TextBlock Text="Editor Suite"
                       FontSize="20"
                       Margin="0,2,0,0" />
            <TextBlock Text="Create, edit and test worlds with the GE2D3D engine."
                       FontSize="14"
                       Margin="0,10,0,0" />
        </StackPanel>

        <UniformGrid Grid.Row="1"
                     Columns="2"
                     Rows="2"
                     Margin="0,32,0,24">
            <Button Margin="10"
                    Padding="20"
                    Click="OpenMapEditor_Click">
                <StackPanel>
                    <TextBlock Text="Map Editor"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Create and edit 2D/3D maps and scenes."
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button Margin="10"
                    Padding="20"
                    Click="OpenRenderTest_Click">
                <StackPanel>
                    <TextBlock Text="Render Test"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Test map loading and the MonoGame renderer."
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button Margin="10"
                    Padding="20"
                    Click="OpenProjectFolder_Click">
                <StackPanel>
                    <TextBlock Text="Project Folder"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Open the GE2D3D project directory."
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button Margin="10"
                    Padding="20"
                    Click="Exit_Click">
                <StackPanel>
                    <TextBlock Text="Exit"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Close the GE2D3D Editor Suite."
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <TextBlock Grid.Row="2"
                   Text="GE2D3D Editor Suite"
                   Opacity="0.6"
                   HorizontalAlignment="Right" />
    </Grid>
</Window>
