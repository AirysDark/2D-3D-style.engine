<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <AssemblyName>GE2D3D.EditorSuite</AssemblyName>
    <RootNamespace>GE2D3D.EditorSuite</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GE2D3D.MapEditor\GE2D3D.MapEditor.csproj" />
    <ProjectReference Include="..\RenderTest\RenderTest.csproj" />
    <ProjectReference Include="..\Prism.Modules.D3D\Prism.Modules.D3D.csproj" />
  </ItemGroup>

  <!-- Create the runtime Content layout beside the built EditorSuite executable. -->
  <Target Name="CreateEditorSuiteContentLayout" AfterTargets="Build">
    <PropertyGroup>
      <SuiteContentRoot>$(TargetDir)Content</SuiteContentRoot>
    </PropertyGroup>

    <MakeDir Directories="$(SuiteContentRoot)" />
    <MakeDir Directories="$(SuiteContentRoot)\Data\maps" />
    <MakeDir Directories="$(SuiteContentRoot)\Data\Scripts" />
    <MakeDir Directories="$(SuiteContentRoot)\Data\Items" />
    <MakeDir Directories="$(SuiteContentRoot)\Data\Moves" />
    <MakeDir Directories="$(SuiteContentRoot)\Data\Types" />
    <MakeDir Directories="$(SuiteContentRoot)\Effects" />
    <MakeDir Directories="$(SuiteContentRoot)\GUI" />
    <MakeDir Directories="$(SuiteContentRoot)\Items" />
    <MakeDir Directories="$(SuiteContentRoot)\Localization" />
    <MakeDir Directories="$(SuiteContentRoot)\Pokemon" />
    <MakeDir Directories="$(SuiteContentRoot)\SkyDomeResource" />
    <MakeDir Directories="$(SuiteContentRoot)\Songs" />
    <MakeDir Directories="$(SuiteContentRoot)\Sounds" />
    <MakeDir Directories="$(SuiteContentRoot)\Textures" />

    <Message Importance="high" Text="GE2D3D EditorSuite Content created at: $(SuiteContentRoot)" />
  </Target>

</Project>
